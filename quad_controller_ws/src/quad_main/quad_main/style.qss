QMainWindow, QWidget#mainwindow {
    background-color: #000000
}

#panel {
    background-color: #0c0c0c;
    border-radius: 12px;
    margin: 10px;
    padding: 15px
}

#invisiblepanel {
    background-color: #000000;
    border-radius: 12px;
    margin: 0px;
    padding: 0px
}

#highlightedcontainer {
    background-color: #ffe83c;
    border-radius: 12px;
    margin: 10px;
    padding: 15px
}

#semihighlightedcontainer {
    background-color: #ffffff;
    border-radius: 12px;
    margin: 10px;
    padding: 15px
}

#transcontainer {
    background-color: #111111;
    border-radius: 12px;
    margin: 10px;
    padding: 15px
}

QPushButton#controlbutton {
    font-family: "DejaVu Sans", "Liberation Sans", sans-serif;
    background-color: #ffffff;
    color: #000000;
    font-weight: bold;
    border-width: 3px;
    border-style: raised;
    padding: 0px
}

QPushButton#controlbutton:hover {
    font-family: "DejaVu Sans", "Liberation Sans", sans-serif;
    background-color: #ffe83c;
    color: #000000;
    font-weight: bold;
    border-width: 3px;
    border-style: raised;
    padding: 0px
}

QPushButton#controlbutton:pressed {
    font-family: "DejaVu Sans", "Liberation Sans", sans-serif;
    background-color: #ffe83c;
    color: #000000;
    font-weight: bold;
    border-width: 3px;
    border-style: raised;
    padding-top: 3px;
    padding-left: 1px
}

#blacklabel {
    color: #000000
}

#whitelabel {
    color: #ffffff
}

#yellowlabel {
    color: #ffe83c
}

QRadioButton {
    font-size: 25px;
    font-family: "Satoshi", sans-serif;
    font-weight: bold;
    color: #000000;
    background-color: #ffffff;
    border: 1px solid #000000;
    border-radius: 8px;
    padding: 10px 18px;
}

QRadioButton::indicator {
    width: 0px;
    height: 0px;
}

QRadioButton:hover {
    background-color: #ffe83c;
    color: #000000
}

QRadioButton:checked {
    background-color: #ffe83c;
    color: #000000
}
